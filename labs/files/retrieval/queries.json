[
  {
    "id": "Q01",
    "text": "ما المستندات المطلوبة لطلب المنحة"
  },
  {
    "id": "Q02",
    "text": "شروط التقديم على منحة الأرض"
  },
  {
    "id": "Q03",
    "text": "كم مدة دراسة الطلب"
  },
  {
    "id": "Q04",
    "text": "كيف أعترض على قرار المنحة"
  },
  {
    "id": "Q05",
    "text": "أولوية ذوي الإعاقة والتقرير الطبي"
  },
  {
    "id": "Q06",
    "text": "موعد الكشف الميداني على الموقع"
  },
  {
    "id": "Q07",
    "text": "تحديث بيانات الأسرة"
  },
  {
    "id": "Q08",
    "text": "استلام الصك بعد القرار"
  },
  {
    "id": "Q09",
    "text": "إجراء التحقق من تكرار الطلب ورقم الجوال"
  },
  {
    "id": "Q10",
    "text": "كيف تحتسب نقاط الأولوية وفئة الدخل"
  },
  {
    "id": "Q11",
    "text": "متى يحال الطلب إلى لجنة المنح"
  },
  {
    "id": "Q12",
    "text": "التحقق من إثبات الدخل"
  },
  {
    "id": "Q13",
    "text": "مطابقة رقم القطعة في المخطط مع الصك"
  },
  {
    "id": "Q14",
    "text": "معالجة الاعتراض وإعادة الدراسة"
  },
  {
    "id": "Q15",
    "text": "حفظ المستندات الممسوحة"
  },
  {
    "id": "Q16",
    "text": "إلغاء الطلب المكرر بعد مذكرة التدقيق"
  },
  {
    "id": "Q17",
    "text": "الطلبات بانتظار مستندات صورة الصك"
  },
  {
    "id": "Q18",
    "text": "الطلبات بانتظار الكشف في الحي D03"
  },
  {
    "id": "Q19",
    "text": "ملخص طلب فيه فرد من ذوي الإعاقة"
  },
  {
    "id": "Q20",
    "text": "طلبات فئة الدخل أ وعدد أفراد الأسرة"
  },
  {
    "id": "Q21",
    "text": "ما قررته اللجنة في نقاط الأولوية"
  },
  {
    "id": "Q22",
    "text": "تحفظ عضو اللجنة على الطلب"
  },
  {
    "id": "Q23",
